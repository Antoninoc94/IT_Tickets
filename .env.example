# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://it_tickets:changeme@postgres:5432/it_tickets?schema=public"
POSTGRES_USER="it_tickets"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="it_tickets"

# ── Application ───────────────────────────────────────────────────────────────
# Secret for signing session tokens — generate with: openssl rand -base64 32
AUTH_SECRET="changeme-32-chars-minimum-random-string"

# Hours of inactivity before the session expires (default: 8)
SESSION_INACTIVITY_HOURS="8"

# Public URL of the app — used in email links (no trailing slash)
APP_URL="https://ticket.azienda.local"

# Restrict self-registration to this email domain. Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAIN="azienda.it"

# Secret token sent in the x-cron-secret header by the cron service.
# Generate with: openssl rand -base64 24
CRON_SECRET="changeme-cron-secret"

# ── Attachments ───────────────────────────────────────────────────────────────
# Max size per uploaded file in MB (default: 25)
MAX_UPLOAD_SIZE_MB="25"
# Where uploaded files are stored. With Docker this is a mounted volume — keep as-is.
UPLOADS_DIR="/app/uploads"

# ── Email provider ────────────────────────────────────────────────────────────
# Switch between SMTP and Microsoft Graph API from Admin → Settings → Email in
# the UI (value stored in the database). Credentials below stay in .env and
# require a server restart when changed.

# Option A — SMTP (default)
SMTP_HOST="mail.azienda.local"
SMTP_PORT="25"
SMTP_SECURE="false"          # set to "true" for TLS on port 465
SMTP_USER=""                 # leave empty if the relay does not require auth
SMTP_PASS=""
SMTP_FROM="IT Tickets <support@azienda.it>"

# Option B — Microsoft Graph API (Office 365)
# Register an app in Azure AD with the Mail.Send *application* permission,
# generate a client secret, then fill in the four values below.
# Leave all four empty when using SMTP.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SENDER_EMAIL=""        # mailbox used as sender, e.g. support@azienda.onmicrosoft.com

# ── Seed (first run only) ─────────────────────────────────────────────────────
# Used by `npx prisma db seed` to create the initial admin account.
SEED_ADMIN_EMAIL="admin@azienda.it"
SEED_ADMIN_PASSWORD="ChangeMe123!"
