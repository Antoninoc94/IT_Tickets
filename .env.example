# PostgreSQL
DATABASE_URL="postgresql://it_tickets:changeme@localhost:5432/it_tickets?schema=public"
POSTGRES_USER="it_tickets"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="it_tickets"

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET="changeme-32-chars-minimum-random-string"

# Internal company SMTP server
SMTP_HOST="mail.internal.example.com"
SMTP_PORT="25"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="IT Tickets <it-tickets@example.com>"

# Public URL of the app (used in email links)
APP_URL="https://it-tickets.example.com"

# Optional: initial admin created by `npx prisma db seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Restrict self-registration to this email domain (leave empty to allow any domain)
ALLOWED_EMAIL_DOMAIN="example.com"

# Ticket attachments: per-file size limit and where uploaded files are stored
# (in Docker this is a mounted volume, see docker-compose.yml)
MAX_UPLOAD_SIZE_MB="25"
UPLOADS_DIR="/app/uploads"
